# Server Port configuration
PORT=5000
PORT_RANGE=20
NODE_ENV=production

# MongoDB Atlas Connection URI (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ace_logistics?retryWrites=true&w=majority

# JSON Web Token Secret Key (Required)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin URL for CORS
CLIENT_URL=http://localhost:3000
FRONTEND_URL=https://ace-app-dusky.vercel.app

# AI API Key for Chatbot (Optional external Gemini LLM)
GEMINI_API_KEY=your_gemini_api_key_here
